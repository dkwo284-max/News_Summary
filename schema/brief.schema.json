{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dkwo284-max/News_Summary/schema/brief.schema.json",
  "title": "Daily Brief",
  "type": "object",
  "required": ["date", "generated_at", "timezone", "sections", "extras"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string" },
    "timezone": { "type": "string" },
    "sections": {
      "type": "object",
      "required": ["kr_society", "kr_economy", "kr_entertainment", "kr_politics", "nz_national", "nz_auckland", "nz_immigration"],
      "additionalProperties": { "$ref": "#/$defs/section" }
    },
    "extras": {
      "type": "object",
      "properties": {
        "nzd_krw": { "type": ["number", "null"] },
        "auckland_weather": {
          "type": ["object", "null"],
          "properties": {
            "max": { "type": "number" },
            "min": { "type": "number" },
            "desc": { "type": "string" }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "failed_feeds": { "type": "array", "items": { "type": "object", "required": ["id", "error"] } },
        "mode": { "type": "string" },
        "usage": { "type": "object" }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["label", "briefing", "items"],
      "properties": {
        "label": { "type": "string" },
        "briefing": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "title_ko", "summary_ko", "tags", "importance", "sources"],
      "properties": {
        "id": { "type": "string" },
        "title_ko": { "type": "string", "minLength": 1 },
        "summary_ko": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "why_it_matters": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "importance": { "type": "integer", "minimum": 1, "maximum": 10 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "pattern": "^https?://" }
            }
          }
        },
        "original_title": { "type": "string" },
        "published_at": { "type": ["string", "null"] }
      }
    }
  }
}
